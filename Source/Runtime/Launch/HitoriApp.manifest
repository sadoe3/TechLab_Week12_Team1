<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  에디터와 게임 exe에 넣는 매니페스트.
  엔진의 FString은 UTF-8인데, char 경로를 받는 API(std::filesystem::path(std::string), fopen, stbi_load, ifstream 등)는
  프로세스 ANSI 코드 페이지로 해석한다. 한국어 Windows에서는 CP949라서 한글 경로의 UTF-8 바이트가 깨지거나
  std::filesystem이 변환 실패로 예외를 던진다.
  activeCodePage를 UTF-8로 두면 이 프로세스의 ANSI 코드 페이지가 UTF-8이 되어, char 경로도 그대로 UTF-8로 읽힌다.
  Windows 10 1903 이상에서 동작한다.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
